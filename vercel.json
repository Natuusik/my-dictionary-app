{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "script.js",
      "use": "@vercel/static"
    },
    {
      "src": "style.css",
      "use": "@vercel/static"
    },
    {
      "src": "supabase.js",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/script.js",
      "dest": "script.js"
    },
    {
      "src": "/style.css",
      "dest": "style.css"
    },
    {
      "src": "/supabase.js",
      "dest": "supabase.js"
    },
    {
      "src": "/(.*)",
      "dest": "index.html"
    }
  ]
}
